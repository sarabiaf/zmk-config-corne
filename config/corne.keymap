#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
// pointing.h is kept for LCLK/MOVE_* should the mouse ever move back into
// firmware. Nothing binds them now: AutoKey drives the pointer from the Alt
// F-keys on the mouse layer, where the speed is a number in jumps.ini.
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define EXTRA 4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        // One tap is an ordinary Shift, held or not; two taps toggle Caps
        // Lock, and two more turn it off again.
        //
        // Each hand gets its own instance rather than sharing one. A tap dance
        // counts taps against the behaviour, and one instance bound to two keys
        // risks a tap on each hand counting as a double tap on neither.
        shift_caps_l: shift_caps_l {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CAPS_L";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };

        shift_caps: shift_caps {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CAPS";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSHFT>, <&kp CAPS>;
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            label = "PARA";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            label = "PARALESS";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            label = "PARAGREAT";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <13 29>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <15 21>;
        };

        perc {
            bindings = <&kp PERCENT>;
            key-positions = <5 17>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <28 16>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <4 16>;
        };

        pound {
            bindings = <&kp POUND>;
            key-positions = <3 15>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <2 14>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <26 14>;
        };

        copy {
            bindings = <&kp K_COPY>;
            key-positions = <28 27>;
        };

        paste {
            bindings = <&kp K_PASTE>;
            key-positions = <26 27>;
        };

        star {
            bindings = <&kp STAR>;
            key-positions = <8 20>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <32 20>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <7 19>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <31 19>;
        };

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <30 18>;
        };

        leftbrack {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <31 32>;
        };

        rightbrack {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <33 32>;
        };

        para-less {
            bindings = <&paraless>;
            key-positions = <20 19>;
        };

        para-great {
            bindings = <&paragreat>;
            key-positions = <20 21>;
        };
    };

    //

    keymap {
        compatible = "zmk,keymap";

        DEF {
            display-name = "L0";

            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&lt 3 GRAVE   &kp Q  &kp W  &kp E         &kp R      &kp T               &kp Y    &kp U            &kp I      &kp O    &kp P     &kp CARET
&lt 1 TAB     &kp A  &kp S  &kp D         &kp F      &kp G               &kp H    &kp J            &kp K      &kp L    &kp SEMI  &mt RIGHT_GUI SQT
&shift_caps_l &kp Z  &kp X  &kp C         &kp V      &kp B               &kp N    &kp M            &kp COMMA  &kp DOT  &kp FSLH  &shift_caps
                            &lt 2 ESCAPE  &kp ENTER  &kp LEFT_CONTROL    &kp BSPC  &kp SPACE  &kp LALT
            >;
        };

        NAV {
            display-name = "L1";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&none  &none  &kp LS(F21)  &kp LS(F20)  &kp LS(F19)  &kp LS(F24)    &kp F24  &kp F19  &kp F20  &kp F21  &none  &studio_unlock
&none  &none  &kp LS(F18)  &kp LS(F17)  &kp LS(F16)  &kp LS(F22)    &kp F22  &kp F16  &kp F17  &kp F18  &none  &none
&none  &none  &kp LS(F15)  &kp LS(F14)  &kp LS(F13)  &kp LS(F23)    &kp F23  &kp F13  &kp F14  &kp F15  &none  &none
                           &trans       &mo 4        &trans         &trans   &trans   &trans
            >;
        };

        SYM {
            display-name = "L2";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp PIPE   &kp AT_SIGN      &kp AMPERSAND  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE    &kp MINUS     &kp N7        &kp N8  &kp N9  &kp ASTERISK  &kp PERCENT
&kp LGUI   &kp EXCLAMATION  &kp DOLLAR     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp HASH          &kp N0  &kp N4        &kp N5  &kp N6  &kp PERIOD    &kp EQUAL
&kp LSHFT  &kp BACKSLASH    &kp DELETE     &kp LEFT_BRACE        &kp RIGHT_BRACE        &none             &kp PLUS      &kp N1  &kp N2  &kp N3        &kp SLASH     &kp RSHFT
                                           &kp ESC               &kp ENTER              &kp LEFT_CONTROL  &kp DELETE    &kp SPACE     &kp LALT
            >;
        };

        ADJ {
            display-name = "L3";
            bindings = <
&none        &none  &kp LC(LS(F21))  &kp LC(LS(F20))  &kp LC(LS(F19))  &kp LC(LS(F24))    &kp F12  &kp F7  &kp F8  &kp F9  &none  &studio_unlock
&none        &none  &kp LC(LS(F18))  &kp LC(LS(F17))  &kp LC(LS(F16))  &kp LC(LS(F22))    &kp F10  &kp F4  &kp F5  &kp F6  &none  &bt BT_CLR
&bootloader  &none  &kp LC(LS(F15))  &kp LC(LS(F14))  &kp LC(LS(F13))  &kp LC(LS(F23))    &kp F11  &kp F1  &kp F2  &kp F3  &none  &bootloader
                                     &trans           &trans           &trans             &trans   &trans  &trans
            >;
        };

        // The mouse layer. Every key sends both Shift keys and one F-key, with
        // no Alt anywhere: a modifier that gets stuck should cost capital
        // letters, not a menu bar and an Alt+F4 - and not GUI's Win+L, which
        // locks the screen. Alt stuck down once already made every NAV key run
        // this layer's actions instead of its own.
        //
        // One modifier pair means the two halves can no longer share F-keys the
        // way NAV's mirror does, so the twelve keys that do something get twelve
        // distinct codes and every other key on the layer is dead. HJKL move,
        // YUIO scroll, SDF click right, middle and left, G is the grid.
        EXTRA {
            display-name = "L4";
            bindings = <
&none  &none  &none            &none            &none            &none              &kp LS(RS(F24))  &kp LS(RS(F19))  &kp LS(RS(F20))  &kp LS(RS(F21))  &none  &studio_unlock
&none  &none  &kp LS(RS(F23))  &kp LS(RS(F13))  &kp LS(RS(F14))  &kp LS(RS(F15))    &kp LS(RS(F22))  &kp LS(RS(F16))  &kp LS(RS(F17))  &kp LS(RS(F18))  &none  &none
&none  &none  &none            &none            &none            &none              &none            &none            &none            &none            &none  &none
                                &trans           &trans           &mkp LCLK          &trans           &trans           &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        l3 {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
